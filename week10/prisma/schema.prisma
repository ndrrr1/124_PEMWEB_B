generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Barang {
  kode      String   @id @db.VarChar(30)
  nama      String   @db.VarChar(80)
  kategori  String   @db.VarChar(30)
  stok      Int      @default(0)
  harga     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([kategori])
}
